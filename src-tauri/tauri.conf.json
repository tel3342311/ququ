{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "蛐蛐",
  "version": "1.0.0",
  "identifier": "com.ququ.app",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../src/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "蛐蛐",
        "url": "index.html",
        "width": 400,
        "height": 500,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "focusable": false,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173; media-src 'self' blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../assets/icon.ico",
      "../assets/icon.png"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "11.0"
    }
  }
}
